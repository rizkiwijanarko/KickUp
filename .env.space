# .env file for HuggingFace Spaces
# Users should set these as Space secrets

# Required API Keys
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}
TAVILY_API_KEY=${TAVILY_API_KEY}

# Optional API Keys
PRODUCTHUNT_API_KEY=${PRODUCTHUNT_API_KEY}
HF_TOKEN=${HF_TOKEN}

# LLM Configuration (defaults to OpenRouter)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-3.5-sonnet
LLM_API_KEY=${OPENROUTER_API_KEY}

# Optional: Fast LLM for quick tasks
FAST_LLM_BASE_URL=https://openrouter.ai/api/v1
FAST_LLM_MODEL=anthropic/claude-3.5-haiku
FAST_LLM_API_KEY=${OPENROUTER_API_KEY}

# Pipeline Configuration
MAX_PAIN_POINTS=10
IDEAS_PER_RUN=2
TOP_N_PITCHES=3
MAX_REVISIONS=2

# Cache Configuration
CACHE_DIR=.cache
CACHE_TTL_HOURS=24

# Gradio Configuration
GRADIO_HOST=0.0.0.0
GRADIO_PORT=7860
